# 环境变量模板（复制为 .env 即可）
# 默认 mock 模式：不配置任何 Key 也能完整跑通演示与复现
MOCK_LLM=1

# 数据库：sqlite（默认，零依赖，评委复现用）| mysql（线上部署用）
# 切到 mysql 时填 MAILUO_DB_URL：mysql://user:pass@host:3306/db?charset=utf8mb4
MAILUO_DB=sqlite
MAILUO_SQLITE_PATH=data/mailuo.sqlite
MAILUO_DB_URL=

# 想用真模型时改成 0，并填写 OpenAI 兼容的 Key
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_MODEL=deepseek-chat

# 索引范围（一般不用改）
MAX_FILES=40
MAX_FILE_BYTES=8192

# 定时保鲜
ENABLE_SCHEDULER=1
SCHEDULE_HOUR=0
TOKEN_BUDGET_PER_PROJECT=80000
